  "pages": [
    "<div class=\"metadata-header\" style=\"display:none;\">informatica|Redes|01 - Conhecimnetos Basicos|Parte - 01</div><div class=\"canvas-box\" data-id=\"box-17940537889130.6693575719635199\" style=\"position: absolute; left: 20px; top: 30px; width: 95%; height: 90%; z-index: 16;  \"><p style=\"line-height: 2;\">CONCEITOS BÁSICOS DE REDES TIPOS DE REDES QUANTO A FORMA DE INTERAÇÃO:  </p><p style=\"line-height: 2;\"></p><p style=\"line-height: 2;\"><strong><em>PAR-A-PAR (</em></strong>“PEER-TO-PEER” OU P2P<strong><em>):</em></strong></p><ol><li><p style=\"line-height: 2;\">NÃO HÁ HIERARQUIA ENTRE OS NÓS;</p></li><li><p style=\"line-height: 2;\">CADA NÓ UTILIZA E FORNECE SERVIÇOS DE FORMA INDEPENDENTE E DINÂMICA;</p></li><li><p style=\"line-height: 2;\">MUITAS QUESTÕES UTILIZAM A NOMENCLATURA “PEER-TO-PEER” OU P2P;</p></li></ol><p style=\"line-height: 2;\"></p><p style=\"line-height: 2;\"><strong><em>CLIENTE-SERVIDOR:</em></strong></p><ol><li><p style=\"line-height: 2;\">EXISTÊNCIA DE SERVIDOR DEDICADO OU COMPARTILHADO PARA FORNECIMENTOS DE RECURSOS DE FORMA CENTRALIZADA OU DISTRIBUÍDA;</p></li><li><p style=\"line-height: 2;\">EXCLUSIVIDADE NA UTILIZAÇÃO OU FORNECIMENTO DE RECURSOS PELOSNÓS;</p></li></ol><p style=\"line-height: 2;\"></p></div>",
    "<div class=\"metadata-header\" style=\"display:none;\">informatica|Redes|01 - Conhecimnetos Basicos|Parte - 01</div><div class=\"canvas-box\" data-id=\"box-17940558810310.9076761874278851\" style=\"position: absolute; left: 20px; top: 30px; width: 95%; height: 90%; z-index: 21;  \"><p style=\"line-height: 2;\">CONCEITOS BÁSICOS DE REDES TIPOS DE CONEXÕES DE REDE: </p><p style=\"line-height: 3;\"><strong><em>1.PONTO-A-PONTO: </em></strong></p><p style=\"line-height: 2;\">1. CONEXÃO DIRETA ENTRE CADA DISPOSITIVO, PERMITINDO UMA COMUNICAÇÃO EXCLUSIVA; </p><p style=\"line-height: 2;\">2. ALTO CUSTO DE CRESCIMENTO:  <span style=\"color: rgb(187, 88, 88);\"><strong>C = N(N-1) / 2 </strong></span> <strong>( N = número de dispositivo )</strong></p><p style=\"line-height: 3;\"><strong><em>MULTIPONTO: </em></strong></p><p style=\"line-height: 2;\">1. CONEXÃO ENTRE OS DISPOSITIVOS ATRAVÉS DE UM MEIO COMPARTILHADO; </p><p style=\"line-height: 2;\">2. MENSAGEM TRAFEGA POR DIFUSÃO, ALCANÇANDO A TODOS OS NÓS;</p></div>",
    "<div class=\"metadata-header\" style=\"display:none;\">informatica|Redes|01 - Conhecimnetos Basicos|Parte - 01</div><div class=\"canvas-box\" data-id=\"box-17940561420480.9403996680906536\" style=\"position: absolute; left: 20px; top: 30px; width: 95.0535%; height: 90.0574%; z-index: 22;  \"><p style=\"line-height: 2;\"><span style=\"color: rgb(187, 88, 88);\"><strong><em>TOPOLOGIAS DE REDES FÍSICAS</em></strong></span></p><p style=\"line-height: 2;\"><strong><em>FATORES IMPORTANTES: </em></strong></p><p style=\"line-height: 2;\">• CONFIABILIDADE, DISPONIBILIDADE E REDUNDÂNCIA; </p><p style=\"line-height: 2;\">• VELOCIDADE DE TRANSMISSÃO; </p><p style=\"line-height: 2;\">• CUSTO DE MANUTENÇÃO; </p><p style=\"line-height: 2;\">• ESCALABILIDADE; ( é fácil adicionar novo dispositivo, é caro ? )</p><p style=\"line-height: 2;\"><strong><em>ESSES FATORES DEFINEM QUAL TOPOLOGIA SERÁ A MAIS RECOMENDADA PARA DETERMINADO AMBIENTE FRENTE AOS REQUISITOS APRESENTADOS.</em></strong></p><p style=\"line-height: 3;\"><strong><em>PRINCIPAIS TOPOLOGIAS:</em></strong></p><p style=\"line-height: 2;\">• BARRAMENTO;</p><p style=\"line-height: 2;\">• ANEL;</p><p style=\"line-height: 2;\">• ESTRELA;</p><p style=\"line-height: 2;\">• MESH E FULL MESH; <strong><em>( malha )</em></strong></p><p style=\"line-height: 2;\">• ÁRVORE OU HIERARQUIZADA; <strong><em>( estrela estendida )</em></strong></p></div>",
    "<div class=\"metadata-header\" style=\"display:none;\">informatica|Redes|01 - Conhecimnetos Basicos|Parte - 01</div><div class=\"canvas-box\" data-id=\"box-17940563472840.6824546882381504\" style=\"position: absolute; left: 20px; top: 30px; width: 94.9198%; height: 53.3461%; z-index: 22;  \"><p style=\"line-height: 2;\"><span style=\"color: rgb(187, 88, 88);\"><strong><em>BARRAMENTO (BUS):</em></strong></span></p><p style=\"line-height: 3;\"><strong><em>CARACTERÍSTICAS:</em></strong></p><p style=\"line-height: 2;\">• UTILIZA O MÉTODO DE <span style=\"color: rgb(187, 88, 88);\"><strong><em>DIFUSÃO (BROADCAST)</em></strong></span> EM UMA CONEXÃO MULTIPONTO;</p><p style=\"line-height: 2;\">• PODE UTILIZAR FORMAS DE <span style=\"color: rgb(187, 88, 88);\"><strong><em>CONTROLE DE ACESSO AO MEIO FÍSICO</em></strong></span> CENTRALIZADO OU</p><p style=\"line-height: 2;\">DESCENTRALIZADO<span style=\"color: rgb(187, 88, 88);\"><strong><em> PARA EVITAR COLISÕES</em></strong></span> DAS INFORMAÇÕES TRAFEGADAS;</p><p style=\"line-height: 2;\">• ESCALÁVEL ATÉ O LIMITE SUPORTADO PELO BARRAMENTO;</p><p style=\"line-height: 2;\">• <span style=\"color: rgb(187, 88, 88);\"><strong><em>NÃO É SEGURO</em></strong></span>, POIS A INFORMAÇÃO ESTARÁ DISPONÍVEL A TODOS NO MEIO;</p><p style=\"line-height: 2;\">• EXCELENTE <span style=\"color: rgb(187, 88, 88);\"><strong><em>TOLERÂNCIA A FALHAS</em></strong></span>;</p></div><div class=\"canvas-box\" data-id=\"box-1794056806524\" style=\"position: absolute; left: 124px; top: 331px; width: 531px; height: 154px; z-index: 23;  \"><img src=\"/uploads/informaticaRedes01ConhecimnetosBasicos-0507ce.png\" alt=\"Imagem\" style=\"width: 100%; height: 100%; object-fit: contain; display: block;\"><p></p></div>",
    "<div class=\"metadata-header\" style=\"display:none;\">informatica|Redes|01 - Conhecimnetos Basicos|Parte - 01</div><div class=\"canvas-box\" data-id=\"box-17940568771650.6353528124102459\" style=\"position: absolute; left: 20px; top: 30px; width: 93.0481%; height: 57.7438%; z-index: 24;  \"><p style=\"line-height: 2;\"><span style=\"color: rgb(187, 88, 88);\"><strong><em>ANEL: </em></strong></span></p><p style=\"line-height: 2;\">CARACTERÍSTICAS: </p><p style=\"line-height: 2;\">• CONEXÕES <span style=\"color: rgb(187, 88, 88);\"><strong><em>PONTO-A-PONTO;</em></strong></span> </p><p style=\"line-height: 2;\">• DEPENDÊNCIA DE NÓS INTERMEDIÁRIOS; </p><p style=\"line-height: 2;\">• À MEDIDA QUE CRESCE, A COMUNICAÇÃO PODE FICAR LENTA, NÃO SENDO ESCALÁVEL; </p><p style=\"line-height: 2;\">• <span style=\"color: rgb(187, 88, 88);\"><strong><em>NÃO É SEGURO</em></strong></span>, POIS A INFORMAÇÃO ESTARÁ DISPONÍVEL A TODOS NO MEIO; </p><p style=\"line-height: 2;\">•<span style=\"color: rgb(187, 88, 88);\"><strong><em> ALTAMENTE SUSCEPTÍVEL A FALHAS; </em></strong></span></p><p style=\"line-height: 2;\">• UTILIZA TOKENS PARA DETERMINAR O ACESSO AO MEIO; </p><p style=\"line-height: 2;\">• NATIVO: <span style=\"color: rgb(187, 88, 88);\"><strong><em>ANEL UNIDIRECIONAL;</em></strong></span></p></div><div class=\"canvas-box\" data-id=\"box-1794056975707\" style=\"position: absolute; left: 205px; top: 360px; width: 300px; height: 138px; z-index: 11;  \"><img src=\"/uploads/informaticaRedes01ConhecimnetosBasicos-c413f9.png\" alt=\"Imagem\" style=\"width: 100%; height: 100%; object-fit: contain; display: block;\"><p></p></div>",
    "<div class=\"metadata-header\" style=\"display:none;\">informatica|Redes|01 - Conhecimnetos Basicos|Parte - 01</div><div class=\"canvas-box\" data-id=\"box-17940570317290.8620073188141338\" style=\"position: absolute; left: 20px; top: 30px; width: 92.246%; height: 55.0669%; z-index: 18;  \"><p style=\"line-height: 2;\"><span style=\"color: rgb(187, 88, 88);\"><strong><em>ANEL: </em></strong></span></p><p style=\"line-height: 2;\"><strong><em>SOLUÇÕES PARA BAIXA DISPONIBILIDADE: </em></strong></p><p style=\"line-height: 2;\">• PODE-SE HABILITAR O <span style=\"color: rgb(187, 88, 88);\"><strong><em>TRÁFEGO BIDIRECIONAL</em></strong></span> PARA CONTORNAR FALHAS; </p><p style=\"line-height: 2;\">• PARA AUMENTAR A CONFIABILIDADE E DISPONIBILIDADE, UTILIZA-SE NA PRÁTICA UM ANEL SECUNDÁRIO; </p><p style=\"line-height: 2;\">• IMPLICA EM UM MAIOR CUSTO </p><ol><li><p style=\"line-height: 2;\">• ENLACE </p></li><li><p style=\"line-height: 2;\">• PLACAS DE REDE;</p></li></ol><p style=\"line-height: 2;\"></p></div><div class=\"canvas-box\" data-id=\"box-1794057513040\" style=\"position: absolute; left: 199px; top: 338px; width: 300px; height: 160px; z-index: 17;  \"><img src=\"/uploads/informaticaRedes01ConhecimnetosBasicos-c69325.png\" alt=\"Imagem\" style=\"width: 100%; height: 100%; object-fit: contain; display: block;\"><p></p></div>",
    "<div class=\"metadata-header\" style=\"display:none;\">informatica|Redes|01 - Conhecimnetos Basicos|Parte - 01</div><div class=\"canvas-box\" data-id=\"box-17940575408560.9744863438903086\" style=\"position: absolute; left: 20px; top: 30px; width: 93.7166%; height: 53.5373%; z-index: 26;  \"><p style=\"line-height: 3;\"><span style=\"color: rgb(187, 88, 88);\"><strong><em>ESTRELA</em></strong></span>: </p><p style=\"line-height: 2;\"><strong><em>CARACTERÍSTICAS: </em></strong></p><p style=\"line-height: 2;\">• CONEXÕES <span style=\"color: rgb(187, 88, 88);\"><strong><em>PONTO-A-PONTO</em></strong></span> EM TORNO DE <span style=\"color: rgb(187, 88, 88);\"><strong><em>UM NÓ CENTRAL</em></strong></span> QUE COMUTARÁ AS MENSAGENS; </p><p style=\"line-height: 2;\">•<strong><em> NECESSITA DE CONTROLE DE ACESSO AO MEIO; </em></strong></p><p style=\"line-height: 2;\">• POSSIBILIDADE DE IMPLEMENTAÇÃO DE RECURSOS DE <strong><em><u>GERÊNCIA DE REDE</u></em></strong>; </p><p style=\"line-height: 2;\">• BOA TOLERÂNCIA A FALHAS, APESAR DE EXISTIR <span style=\"color: rgb(187, 88, 88);\"><strong><em>UM PONTO CRÍTICO DE FALHA</em></strong></span>; (Central)</p><p style=\"line-height: 2;\">• EXPANSÃO E PROCESSAMENTO DA REDE DEPENDE DA CAPACIDADE DO <span style=\"color: rgb(187, 88, 88);\"><strong><em>NÓ CENTRAL</em></strong></span>;</p></div><div class=\"canvas-box\" data-id=\"box-1794057773581\" style=\"position: absolute; left: 193px; top: 341px; width: 300px; height: 138px; z-index: 25;  \"><img src=\"/uploads/informaticaRedes01ConhecimnetosBasicos-30ef46.png\" alt=\"Imagem\" style=\"width: 100%; height: 100%; object-fit: contain; display: block;\"><p></p></div>",
    "<div class=\"metadata-header\" style=\"display:none;\">informatica|Redes|01 - Conhecimnetos Basicos|Parte - 01</div><div class=\"canvas-box\" data-id=\"box-17940578198950.08042827324632551\" style=\"position: absolute; left: 20px; top: 30px; width: 90.6417%; height: 57.7438%; z-index: 26;  \"><p style=\"line-height: 2;\"><span style=\"color: rgb(187, 88, 88);\"><strong><em>MESH OU MALHA: </em></strong></span></p><p style=\"line-height: 2;\"><strong><em>CARACTERÍSTICAS</em></strong>: </p><p style=\"line-height: 2;\">• INTERCONEXÃO PONTO-A-PONTO ENTRE <span style=\"color: rgb(187, 88, 88);\"><strong><em>ALGUNS NÓS;</em></strong></span> </p><p style=\"line-height: 2;\"><span style=\"color: rgb(187, 88, 88);\"><strong><em>• POUCO ESCALÁVEL; </em></strong></span></p><p style=\"line-height: 2;\"><span style=\"color: rgb(187, 88, 88);\"><strong><em>• EXCELENTE TOLERÂNCIA A FALHAS; </em></strong></span></p><p style=\"line-height: 2;\">• DESEMPENHO VINCULADO AOS <span style=\"color: rgb(187, 88, 88);\"><strong><em>ENLACES ENTRE CADA PAR</em></strong></span>; </p><p style=\"line-height: 2;\">• TEM COMO VARIAÇÃO AS <span style=\"color: rgb(187, 88, 88);\"><strong><em>REDES FULL MESH</em></strong></span><span style=\"color: rgb(30, 41, 59);\"><strong><em> (CONEXÃO ENTRE TODOS OS DISPOSITIVOS </em></strong></span></p><p style=\"line-height: 2;\"><span style=\"color: rgb(30, 41, 59);\"><strong><em>ENTRE SI); </em></strong></span></p><p style=\"line-height: 2;\">• AMPLIFICA-SE AS VANTAGENS E DESVANTAGENS;</p></div><div class=\"canvas-box\" data-id=\"box-1794058010543\" style=\"position: absolute; left: 29px; top: 359px; width: 300px; height: 126px; z-index: 22;  \"><img src=\"/uploads/informaticaRedes01ConhecimnetosBasicos-6dfdb7.png\" alt=\"Imagem\" style=\"width: 100%; height: 100%; object-fit: contain; display: block;\"><p></p></div><div class=\"canvas-box\" data-id=\"box-1794058040324\" style=\"position: absolute; left: 389px; top: 357px; width: 304px; height: 134px; z-index: 24;  \"><img src=\"/uploads/informaticaRedes01ConhecimnetosBasicos-2912c2.png\" alt=\"Imagem\" style=\"width: 100%; height: 100%; object-fit: contain; display: block;\"><p></p></div>",
    "<div class=\"metadata-header\" style=\"display:none;\">informatica|Redes|01 - Conhecimnetos Basicos|Parte - 01</div><div class=\"canvas-box\" data-id=\"box-17940581103560.09367813200080521\" style=\"position: absolute; left: 20px; top: 30px; width: 95.1872%; height: 47.0363%; z-index: 13;  \"><p style=\"line-height: 3;\"><span style=\"color: rgb(187, 88, 88);\"><strong><em>ÁRVORE:</em></strong></span></p><p style=\"line-height: 3;\"><strong><em>CARACTERÍSTICAS: (ligado pelos nós centrais)</em></strong></p><p style=\"line-height: 2;\">• HIERARQUIZAÇÃO ENTRE OS CONCENTRADORES;</p><p style=\"line-height: 2;\">• DERIVAÇÃO DA REDE EM ESTRELA;</p><p style=\"line-height: 2;\">• TOPOLOGIA UTILIZADA NA MAIORIA DOS AMBIENTES DE REDE;</p><p style=\"line-height: 2;\">• POSSUI BOA ESCALABILIDADE E TOLERÂNCIA A FALHAS;</p></div><div class=\"canvas-box\" data-id=\"box-1794058163552\" style=\"position: absolute; left: 222px; top: 306px; width: 300px; height: 163px; z-index: 11;  \"><img src=\"/uploads/informaticaRedes01ConhecimnetosBasicos-6fa3c4.png\" alt=\"Imagem\" style=\"width: 100%; height: 100%; object-fit: contain; display: block;\"><p></p></div>",
    "<div class=\"metadata-header\" style=\"display:none;\">informatica|Redes|01 - Conhecimnetos Basicos|Parte - 01</div><div class=\"canvas-box\" data-id=\"box-17940583111820.27436529014041844\" style=\"position: absolute; left: 20px; top: 30px; width: 95%; height: 90%; z-index: 25;  \"><p style=\"line-height: 2;\">TOPOLOGIA LÓGICA X FÍSICA</p><p style=\"line-height: 2;\"><strong><em>DEFINIÇÃO</em></strong>:</p><p style=\"line-height: 2;\"><strong><em>• TOPOLOGIA LÓGICA:</em></strong> FORMA COMO OS DADOS SÃO TRAFEGADOS;</p><p style=\"line-height: 2;\"><strong><em>• TOPOLOGIA FÍSICA:</em></strong> FORMA COMO OS NÓS SÃO INTERCONECTADOS;</p><p style=\"line-height: 2;\"></p><ul><li><p style=\"line-height: 2;\">TOPOLOGIA LÓGICA OPERA SOBRE A TOPOLOGIA FÍSICA;</p></li><li><p style=\"line-height: 2;\">TOPOLOGIA LÓGICA PODE VARIAR COM O TIPO DE EQUIPAMENTO UTILIZADO E DA</p></li></ul><p style=\"line-height: 2;\">CONFIGURAÇÃO DE REDE REALIZADA;</p><p style=\"line-height: 2;\"></p><p style=\"line-height: 2;\"><span style=\"color: rgb(187, 88, 88);\"><strong><em>NÃO NECESSARIAMENTE DEVEM SER IGUAIS.</em></strong></span> PODE-SE TER: </p><p style=\"line-height: 2;\">• TOPOLOGIA <span style=\"color: rgb(187, 88, 88);\"><strong><em>FÍSICA EM ESTRELA</em></strong></span> COM TOPOLOGIA <span style=\"color: rgb(89, 122, 177);\"><strong><em>LÓGICA EM BARRAMENTO</em></strong></span><strong><em>; </em></strong></p><p style=\"line-height: 2;\">• TOPOLOGIA <span style=\"color: rgb(187, 88, 88);\"><strong><em>FÍSICA EM ESTRELA</em></strong></span> COM TOPOLOGIA <span style=\"color: rgb(89, 122, 177);\"><strong><em>LÓGICA EM ANEL;</em></strong></span> </p><p style=\"line-height: 2;\">• ENTRE OUTRAS.</p></div>",
    "<div class=\"metadata-header\" style=\"display:none;\">informatica|Redes|01 - Conhecimnetos Basicos|Parte - 01</div><div class=\"canvas-box\" data-id=\"box-17940595648960.5885988927507153\" style=\"position: absolute; left: 22px; top: 27px; width: 92.5134%; height: 69.7897%; z-index: 33;  \"><p style=\"line-height: 2;\"><span style=\"color: rgb(187, 88, 88);\"><strong><em>CSMA/CD vs CSMA/CA</em></strong></span></p><p style=\"line-height: 2;\">CSMA/CD (CARRIER SENSE MULTIPLE ACCESS WITH  / COLLISION DETECTION)</p><p style=\"line-height: 2;\"><strong><em>FUNCIONAMENTO</em></strong>:</p><ol><li><p style=\"line-height: 2;\">O NÓ VERIFICA SE O MEIO ESTÁ LIVRE PARA TRANSMISSÃO;</p></li><li><p>ESTANDO LIVRE, O NÓ COMEÇA SUA TRANSMISSÃO MANTENDO A ESCUTA DO MEIO COM A TECNOLOGIA LWT (<span style=\"color: rgb(187, 88, 88);\"><strong><em>LISTEN WHILE TALK</em></strong></span>)</p></li><li><p>CASO IDENTIFIQUE UM OUTRO SINAL SENDO TRANSMITIDO, INICIA-SE O <span style=\"color: rgb(187, 88, 88);\"><strong><em>ALGORITMO DE RECUPERAÇÃO </em></strong></span>(<span style=\"color: rgb(187, 88, 88);\"><strong><em>BACKOFF</em></strong></span>) PARA ESTABILIZAÇÃO DO MEIO E FUTURA RETRANSMISSÃO:</p></li></ol><ul><li><p>ENVIA-SE UM SINAL <span style=\"color: rgb(84, 131, 115);\"><strong><em>JAM (altamente amplificado)</em></strong></span> DIVULGANDO A COLISÃO;</p></li><li><p>TODOS PARAM DE TRANSMITIR IMEDIATAMENTE;</p></li><li><p>OS QUE DESEJAM TRANSMITIR, AGUARDAM UM TEMPO ALEATÓRIO PARA TENTAR A TRANSMISSÃO, REINICIANDO O PROCESSO.</p></li></ul><p></p><p><span style=\"color: rgb(187, 88, 88);\"><strong><em>OBS: NÃO HÁ PREVENÇÃO DE COLISÃO, MAS TÃO SOMENTE A DETECÇÃO!!!</em></strong></span></p><p><span style=\"color: rgb(187, 88, 88);\"><strong><em>PRINCIPAL APLICAÇÃO: ETHERNET;</em></strong></span></p></div><div class=\"canvas-box\" data-id=\"box-1794143068941\" style=\"position: absolute; left: 482px; top: 404px; width: 271px; height: 97px; z-index: 29;  \"><img src=\"/uploads/informaticaRedes01ConhecimnetosBasicos-15e782.png\" alt=\"Imagem\" style=\"width: 100%; height: 100%; object-fit: contain; display: block;\"><p></p></div>",
    "<div class=\"metadata-header\" style=\"display:none;\">informatica|Redes|01 - Conhecimnetos Basicos|Parte - 01</div><div class=\"canvas-box\" data-id=\"box-1794143300860\" style=\"position: absolute; left: 225px; top: 63px; width: 300px; height: 300px; z-index: 2;  \"><img src=\"/uploads/informaticaRedes01ConhecimnetosBasicos-099f7e.png\" alt=\"Imagem\" style=\"width: 100%; height: 100%; object-fit: contain; display: block;\"><p></p></div>",
    "<div class=\"metadata-header\" style=\"display:none;\">informatica|Redes|01 - Conhecimnetos Basicos|Parte - 01</div><div class=\"canvas-box\" data-id=\"box-17941433418160.9811832101906004\" style=\"position: absolute; left: 20px; top: 30px; width: 95%; height: 90%; z-index: 25;  \"><p style=\"line-height: 2;\"><span style=\"color: rgb(187, 88, 88);\"><strong><em>CSMA/CD X CSMA/CA</em></strong></span></p><p style=\"line-height: 2;\"><strong><em>CSMA/CA (CARRIER SENSE MULTIPLE ACCESS WITH COLLISION AVOIDANCE)</em></strong></p><p style=\"line-height: 2;\">• SUCESSOR DO CSMA/CD;</p><p style=\"line-height: 2;\"></p><p style=\"line-height: 2;\"><strong><em>FUNCIONAMENTO:</em></strong></p><ol><li><p style=\"line-height: 2;\">O NÓ VERIFICA SE O MEIO ESTÁ LIVRE PARA TRANSMISSÃO;</p></li><li><p style=\"line-height: 2;\">ESTANDO LIVRE, <span style=\"color: rgb(187, 88, 88);\"><em>O NÓ ENVIA UM PACOTE INFORMACIONAL</em></span> A TODOS OS DISPOSITIVOS DIZENDO O TEMPO QUE PRETENDE OCUPAR O MEIO PARA TRANSMITIR OS DADOS;</p></li><li><p style=\"line-height: 2;\">AS DEMAIS ESTAÇÕES TOMAM CIÊNCIA E NEM MESMO VERIFICAM O MEIO DURANTE ESSE PERÍODO;</p></li></ol><p></p><p style=\"line-height: 2;\"><span style=\"color: rgb(187, 88, 88);\"><em>OBS: AQUI HÁ A PREVENÇÃO DE COLISÃO!!!</em></span></p><p style=\"line-height: 2;\"><span style=\"color: rgb(187, 88, 88);\"><em>PRINCIPAL APLICAÇÃO: </em></span><span style=\"color: rgb(84, 131, 115);\"><strong><em>REDES WIRELESS</em></strong></span></p></div>",
    "<div class=\"metadata-header\" style=\"display:none;\">informatica|Redes|01 - Conhecimnetos Basicos|Parte - 01</div><div class=\"canvas-box\" data-id=\"box-17941438309010.6154891367733615\" style=\"position: absolute; left: 20px; top: 30px; width: 95%; height: 90%; z-index: 29;  \"><p style=\"line-height: 2;\"><strong><em>CLASSIFICAÇÃO DAS REDES DE COMPUTADORES</em></strong></p><p style=\"line-height: 2;\"><span style=\"font-size: 14px;\"><strong><em>ESSA CLASSIFICAÇÃO CONSIDERA ASPECTOS GEOGRÁFICOS, AINDA QUE NÃO MUITO BEM DEFINIDOS ATUALMENTE;</em></strong></span></p><p style=\"line-height: 2;\"><span style=\"color: rgb(187, 88, 88);\"><strong><em>AS PRINCIPAIS SÃO:</em></strong></span></p><ol><li><p style=\"line-height: 2;\">• PAN (PERSONAL AREA NETWORK)</p></li><li><p style=\"line-height: 2;\">• TAN (TINY AREA NETWORK)</p></li><li><p style=\"line-height: 2;\">• LAN (LOCAL AREA NETWORK)</p></li><li><p style=\"line-height: 2;\">• CAN (CAMPUS AREA NETWORK)</p></li><li><p style=\"line-height: 2;\">• MAN (METROPOLITAN AREA NETWORK)</p></li><li><p style=\"line-height: 2;\">• WAN (WIDE AREA NETWORK)</p></li><li><p style=\"line-height: 2;\">• WLAN (WIRELESS LOCAL AREA NETWORK)</p></li></ol><p style=\"line-height: 2;\"></p></div>",
    "<div class=\"metadata-header\" style=\"display:none;\">informatica|Redes|01 - Conhecimnetos Basicos|Parte - 01</div><div class=\"canvas-box\" data-id=\"box-17941440942760.8141266694998412\" style=\"position: absolute; left: 20px; top: 30px; width: 95%; height: 90%; z-index: 32;  \"><p style=\"line-height: 2;\"><span style=\"color: rgb(187, 88, 88);\"><strong><em>LAN - </em></strong></span>LOCAL AREA NETWORK</p><p style=\"line-height: 3;\"><strong><em>CARACTERÍSTICAS:</em></strong></p><p style=\"line-height: 2;\">• TAMBÉM CONHECIDAS COMO REDES LOCAIS;</p><p style=\"line-height: 2;\">• PODE UTILIZAR DIVERSOS <span style=\"color: rgb(187, 88, 88);\"><strong><em>TIPOS DE CABOS E TOPOLOGIAS DISTINTAS;</em></strong></span></p><p style=\"line-height: 2;\">• TIPO DE REDE MAIS UTILIZADA;</p><p style=\"line-height: 2;\">• A PRINCIPAL TECNOLOGIA É A <span style=\"color: rgb(187, 88, 88);\"><strong><em>ETHERNET;</em></strong></span></p><p style=\"line-height: 3;\"><strong><em>ASPECTOS DA REDE:</em></strong></p><p style=\"line-height: 2;\">• ALTA TAXA DE TRANSMISSÃO <span style=\"color: rgb(187, 88, 88);\"><strong><em>(GBPS,MBPS);</em></strong></span></p><p style=\"line-height: 2;\">• <span style=\"color: rgb(187, 88, 88);\"><strong><em>BAIXA TAXA DE ERROS E RETRANSMISSÕES;</em></strong></span></p><p style=\"line-height: 2;\">• BAIXO CUSTO DE CABEAMENTO;</p><p style=\"line-height: 2;\">• PRINCIPAL TOPOLOGIA: <span style=\"color: rgb(187, 88, 88);\"><strong><em>ESTRELA</em></strong></span> (<span style=\"color: rgb(84, 131, 115);\"><strong><em>ÁRVORE</em></strong></span> EM SEU MODELO EXPANDIDO)</p></div>",
    "<div class=\"metadata-header\" style=\"display:none;\">informatica|Redes|01 - Conhecimnetos Basicos|Parte - 01</div><div class=\"canvas-box\" data-id=\"box-17941442597340.40644823698798616\" style=\"position: absolute; left: 20px; top: 30px; width: 95%; height: 90%; z-index: 32;  \"><p style=\"line-height: 2;\"><span style=\"color: rgb(187, 88, 88);\"><strong><em>MAN - </em></strong></span>METROPOLITAN AREA NETWORK</p><p style=\"line-height: 2;\"><strong><em>CARACTERÍSTICAS</em></strong>: </p><ul><li><p style=\"line-height: 2;\">PODEM COBRIR UMA CIDADE OU UM BAIRRO; </p></li><li><p style=\"line-height: 2;\">INTERLIGA VÁRIAS <span style=\"color: rgb(187, 88, 88);\"><em>LAN’S</em></span>; </p></li><li><p style=\"line-height: 2;\"><span style=\"color: rgb(187, 88, 88);\"><em>MAJORITARIAMENTE</em></span> VIA CABOS DE <span style=\"color: rgb(187, 88, 88);\"><em>FIBRA ÓPTICA</em></span>; </p></li><li><p style=\"line-height: 2;\">A PRINCIPAL TECNOLOGIA É A <span style=\"color: rgb(187, 88, 88);\"><em>ETHERNET</em></span>. <br>DAÍ A NOMENCLATURA DE <span style=\"color: rgb(187, 88, 88);\"><strong><em>METRO ETHERNET</em></strong></span> QUANDO UTILIZADA EM MAN; </p></li></ul><p style=\"line-height: 2;\"><strong><em>ASPECTOS DA REDE:</em></strong></p><ul><li><p style=\"line-height: 2;\"> ALTA TAXA DE TRANSMISSÃO (10GBPS, GBPS E MBPS); </p></li><li><p style=\"line-height: 2;\"> BAIXA/<span style=\"color: rgb(187, 88, 88);\"><em>MÉDIA</em></span> TAXA DE ERROS; (EM RELAÇÃO A LAN)</p></li><li><p style=\"line-height: 2;\">CUSTO DE CABEAMENTO <span style=\"color: rgb(187, 88, 88);\"><strong><em>MÉDIO</em></strong></span>; </p></li><li><p style=\"line-height: 2;\">UTILIZA-SE GERALMENTE A TOPOLOGIA <span style=\"color: rgb(187, 88, 88);\"><strong><em>EM ANEL</em></strong></span> POR SER MAIS ECONÔMICA EM REGIÕES METROPOLITANAS.</p></li></ul><p style=\"line-height: 2;\"></p></div>",
    "<div class=\"metadata-header\" style=\"display:none;\">informatica|Redes|01 - Conhecimnetos Basicos|Parte - 01</div><div class=\"canvas-box\" data-id=\"box-17941451468130.9910835953072185\" style=\"position: absolute; left: 20px; top: 30px; width: 95%; height: 90%; z-index: 38;  \"><p style=\"line-height: 2;\"><span style=\"color: rgb(187, 88, 88);\"><strong><em>WAN - </em></strong></span>WIDE AREA NETWORK</p><p style=\"line-height: 2;\"><strong><em>CARACTERÍSTICAS:</em></strong></p><ul><li><p style=\"line-height: 2;\">PODEM COBRIR UM <span style=\"color: rgb(187, 88, 88);\"><strong><em>PAÍS OU CONTINENTE</em></strong></span>;</p></li><li><p style=\"line-height: 2;\">INTERLIGA VÁRIAS <span style=\"color: rgb(187, 88, 88);\"><strong><em>MAN’S E LAN’S</em></strong></span>;</p></li><li><p style=\"line-height: 2;\">MAJORITARIAMENTE VIA CABOS DE FIBRA ÓPTICA. ALGUMAS IMPLEMENTAM SOLUÇÕES VIA</p></li></ul><p style=\"line-height: 2;\"><span style=\"color: rgb(187, 88, 88);\"><strong><em>SATÉLITE</em></strong></span>;</p><p style=\"line-height: 2;\"><strong><em>ASPECTOS DA REDE:</em></strong></p><ul><li><p style=\"line-height: 2;\">TAXAS DE TRANSMISSÃO VARIADAS DEVIDO AS DIVERSAS INTEMPERES(10GBPS, GBPS, MBPS E KBPS);</p></li><li><p style=\"line-height: 2;\">TAXAS DE ERROS MAIS ELEVADAS;</p></li><li><p style=\"line-height: 2;\">CUSTO DE CABEAMENTO ALTO;</p></li></ul><p></p></div>",
    "<div class=\"metadata-header\" style=\"display:none;\">informatica|Redes|01 - Conhecimnetos Basicos|Parte - 01</div><div class=\"canvas-box\" data-id=\"box-17941454733400.4268596506447483\" style=\"position: absolute; left: 20px; top: 30px; width: 95%; height: 90%; z-index: 23;  \"><p style=\"line-height: 2;\"><span style=\"color: rgb(187, 88, 88);\"><strong>WLAN - </strong></span>WIRELESS LOCAL AREA NETWORK</p><p style=\"line-height: 2;\"><strong>CARACTERÍSTICAS: </strong></p><p style=\"line-height: 2;\">VARIAÇÃO DA LAN COMO REDE SEM FIO; </p><p style=\"line-height: 2;\">O <span style=\"color: rgb(187, 88, 88);\"><strong><em>WI-FI</em></strong></span> (<span style=\"color: rgb(187, 88, 88);\"><em>WIRELESS FIDELITY</em></span>) É UMA ESPÉCIE DE REDE WLAN; </p><p style=\"line-height: 2;\">PODE-SE UTILIZAR TECNOLOGIAS COMO <span style=\"color: rgb(89, 122, 177);\"><strong><em>BLUETOOTH </em></strong></span>OU <span style=\"color: rgb(187, 88, 88);\"><em>INFRAVERMELHO</em></span>; </p><p style=\"line-height: 2;\"></p><p style=\"line-height: 2;\">OBS. QUALQUER VARIAÇÃO DAS DEMAIS REDES ACEITAM CONEXÕES SEM FIO. ASSIM, PODE-SE TER WMAN E WWAN;</p></div>",
    "<div class=\"metadata-header\" style=\"display:none;\">informatica|Redes|01 - Conhecimnetos Basicos|Parte - 01</div><div class=\"canvas-box\" data-id=\"box-17941456291900.2967390999827336\" style=\"position: absolute; left: 20px; top: 30px; width: 95%; height: 90%; z-index: 20;  \"><p style=\"line-height: 2;\"><span style=\"color: rgb(187, 88, 88);\"><strong><em>MEIOS DE TRANSMISSÃO</em></strong></span></p><p style=\"line-height: 3;\"><strong><em>CATEGORIAS: </em></strong></p><p style=\"line-height: 2;\"><span style=\"color: rgb(84, 131, 115);\"><strong><em>MEIOS GUIADOS</em></strong></span> – DEPENDEM DE UM MEIO FÍSICO PARA CONDUZIR O SINAL DE FORMA DETERMINADA; </p><p style=\"line-height: 2;\"><span style=\"color: rgb(187, 88, 88);\"><strong><em>MEIOS NÃO GUIADOS </em></strong></span>– NÃO DEPENDEM DE UM MEIO FÍSICO PARA CONDUZIR O SINAL. UTILIZA-SE ONDAS ELETROMAGNÉTICAS TRANSMITIDAS PELO <span style=\"color: rgb(187, 88, 88);\"><strong><em><u>AR</u></em></strong></span>;</p></div>",
    "<div class=\"metadata-header\" style=\"display:none;\">informatica|Redes|01 - Conhecimnetos Basicos|Parte - 01</div><div class=\"canvas-box\" data-id=\"box-17941457218500.5385188645933455\" style=\"position: absolute; left: 20px; top: 30px; width: 95.4545%; height: 44.9331%; z-index: 38;  \"><p style=\"line-height: 2;\"><span style=\"color: rgb(187, 88, 88);\"><strong><em>CABO COAXIAL:</em></strong></span></p><p style=\"line-height: 2;\">É UM TIPO DE CABO <span style=\"color: rgb(89, 122, 177);\"><strong><em>METÁLICO</em></strong></span>, SENDO PORTANTO UM <span style=\"color: rgb(89, 122, 177);\"><strong><em>MEIO GUIADO</em></strong></span>;</p><p style=\"line-height: 2;\"><strong><em>CATEGORIAS</em></strong>:</p><ul><li><p style=\"line-height: 2;\"><span style=\"color: rgb(187, 88, 88);\"><strong>10</strong></span><span style=\"color: rgb(89, 122, 177);\"><strong><em>BASE</em></strong></span><span style=\"color: rgb(187, 88, 88);\"><strong><em>2 </em></strong></span>(<span style=\"color: rgb(187, 88, 88);\"><strong><em>THINNET</em></strong></span>) – <span style=\"color: rgb(187, 88, 88);\"><em>SUPORTA 10MBPS</em></span> A UMA DISTÂNCIA DE 185M. TAMBÉM CHAMADOS DE CABOS COAXIAIS FINOS;</p></li><li><p style=\"line-height: 2;\"><span style=\"color: rgb(187, 88, 88);\"><strong>10</strong></span><span style=\"color: rgb(89, 122, 177);\"><strong><em>BASE</em></strong></span><span style=\"color: rgb(187, 88, 88);\"><strong><em>5</em></strong></span> (<span style=\"color: rgb(187, 88, 88);\"><strong><em>THICKNET</em></strong></span>) – SUPORTA 10MPBS A UMA DISTÂNCIA DE 500M. TAMBÉM CHAMADOS DE CABOS COAXIAIS GROSSOS. SÃO MAIS CAROS E MAIS DIFÍCEIS DE SE MANUSEAR;</p></li></ul><p style=\"line-height: 2;\"></p></div><div class=\"canvas-box\" data-id=\"box-1794145851927\" style=\"position: absolute; left: 52px; top: 325px; width: 251px; height: 135px; z-index: 21;  \"><img src=\"/uploads/informaticaRedes01ConhecimnetosBasicos-b8b30a.png\" alt=\"Imagem\" style=\"width: 100%; height: 100%; object-fit: contain; display: block;\"><p></p></div><div class=\"canvas-box\" data-id=\"box-1794145865562\" style=\"position: absolute; left: 438px; top: 330px; width: 223px; height: 126px; z-index: 22;  \"><img src=\"/uploads/informaticaRedes01ConhecimnetosBasicos-f84b6c.png\" alt=\"Imagem\" style=\"width: 100%; height: 100%; object-fit: contain; display: block;\"><p></p></div>",
    "<div class=\"metadata-header\" style=\"display:none;\">informatica|Redes|01 - Conhecimnetos Basicos|Parte - 01</div><div class=\"canvas-box\" data-id=\"box-17941461952670.4350005698317886\" style=\"position: absolute; left: 20px; top: 30px; width: 95%; height: 90%; z-index: 50;  \"><p style=\"line-height: 2;\"><span style=\"color: rgb(187, 88, 88);\"><strong><em>CABO PAR TRANÇADO (TWISTED PAIR):</em></strong></span></p><p style=\"line-height: 2;\">• É UM TIPO DE <strong><em>CABO METÁLICO</em></strong>, SENDO PORTANTO UM MEIO GUIADO;</p><p style=\"line-height: 2;\">• <strong><em>MELHOR CUSTO X BENEFÍCIO</em></strong>. POR ISSO SÃO MAIS UTILIZADOS;</p><p style=\"line-height: 2;\">• MAIOR VELOCIDADE QUANDO COMPARADO AOS CABOS COAXIAIS;</p><p style=\"line-height: 2;\">• SÃO MAIS MALEÁVEIS;</p><p style=\"line-height: 2;\">• AS TRANÇAS EM SEUS 4 PARES <strong><em>REDUZEM OS NÍVEIS DE RUÍDO E INTERFERÊNCIA</em></strong>;</p><p style=\"line-height: 2;\"><strong><em>SÃO DIVIDIDOS EM 4 CATEGORIAS:</em></strong></p><p style=\"line-height: 2;\">• <span style=\"color: rgb(187, 88, 88);\"><strong><em>UTP</em></strong></span> (UNSHIELDED TWISTED PAIR) – <span style=\"color: rgb(187, 88, 88);\"><strong><em>CABOS SEM BLINDAGEM</em></strong></span>.</p><p style=\"line-height: 2;\">• <span style=\"color: rgb(89, 122, 177);\"><strong><em>FTP</em></strong></span> (FOILED TWISTED PAIR) – <span style=\"color: rgb(89, 122, 177);\"><strong><em>BLINDAGEM SIMPLES</em></strong></span></p><p style=\"line-height: 2;\">PARA REDUZIR INTERFERÊNCIA EXTERNA. NÃO TRATA “CROSSTALK”.</p><p style=\"line-height: 2;\">• <span style=\"color: rgb(84, 131, 115);\"><strong><em>STP</em></strong></span> (SHIELDED TWISTED PAIR) – POSSUI APENAS <span style=\"color: rgb(89, 122, 177);\">BLINDAGEM</span></p><p style=\"line-height: 2;\"><span style=\"color: rgb(89, 122, 177);\">ENTRE</span> <span style=\"color: rgb(89, 122, 177);\">OS</span> <span style=\"color: rgb(89, 122, 177);\">PARES</span> PARA REDUZIR O “CROSSTALK”.</p><p style=\"line-height: 2;\">•<strong><em>SSTP</em></strong> (SREENED SHIELDED PAIR) OU SFTP – <span style=\"color: rgb(89, 122, 177);\">UNIFICA</span> AS <span style=\"color: rgb(89, 122, 177);\">DUAS</span></p><p style=\"line-height: 2;\"><span style=\"color: rgb(89, 122, 177);\">CATEGORIAS</span> ACIMA, COM <span style=\"color: rgb(89, 122, 177);\">BLINDAGEM</span> <span style=\"color: rgb(89, 122, 177);\">EXTERNA</span> E ENTRE OS PARES;</p></div>",
    "<div class=\"metadata-header\" style=\"display:none;\">informatica|Redes|01 - Conhecimnetos Basicos|Parte - 01</div><div class=\"canvas-box\" data-id=\"box-17941469103610.06759270537668582\" style=\"position: absolute; left: 20px; top: 35px; width: 91.3102%; height: 19.6941%; z-index: 7;  \"><p style=\"line-height: 2;\"><strong>CABO UTP: </strong></p><p style=\"line-height: 2;\"><strong>SÃO DIVIDIDOS EM VÁRIAS CATEGORIAS EM TERMOS DE CAPACIDADE. RESSALTA-SE QUE TODOS ELES POSSUEM DISTÂNCIA MÁXIMA DE 100M.</strong></p></div><div class=\"canvas-box\" data-id=\"box-1794147496480\" style=\"position: absolute; left: 26px; top: 170px; width: 741px; height: 315px; z-index: 8;  \"><img src=\"/uploads/informaticaRedes01ConhecimnetosBasicos-6e80fc.png\" alt=\"Imagem\" style=\"width: 100%; height: 100%; object-fit: contain; display: block;\"><p></p></div>",
